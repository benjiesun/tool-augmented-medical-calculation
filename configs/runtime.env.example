# Copy this file to repository-root runtime.env. Never commit the copied file.

# ---------- Shared API defaults ----------
PYTHON_BIN=python
API_KEY=
API_BASE=

# ---------- Central reasoning / final formatting model ----------
# MODE is "api" or "local".
CENTRAL_MODE=api
CENTRAL_API_KEY=
CENTRAL_API_BASE=
CENTRAL_MODEL_NAME=
CENTRAL_MODEL_PATH=
CENTRAL_TP=1
CENTRAL_MAX_INPUT_TOKENS=20000
CENTRAL_MAX_NEW_TOKENS=1800
CENTRAL_GPU_MEMORY_UTILIZATION=0.90

# ---------- Tool-writing model ----------
TOOL_WRITER_MODE=api
TOOL_WRITER_API_KEY=
TOOL_WRITER_API_BASE=
TOOL_WRITER_MODEL_NAME=
TOOL_WRITER_MODEL_PATH=
TOOL_WRITER_TP=1
TOOL_WRITER_MAX_INPUT_TOKENS=20000
TOOL_WRITER_MAX_NEW_TOKENS=1800
TOOL_WRITER_GPU_MEMORY_UTILIZATION=0.90
TOOL_WRITER_TEMPERATURE=0.0
TOOL_WRITER_TOP_P=1.0

# ---------- Optional rule-curation model ----------
# Empty values fall back to TOOL_WRITER_*.
RULE_RETRIEVER_MODE=
RULE_RETRIEVER_API_KEY=
RULE_RETRIEVER_API_BASE=
RULE_RETRIEVER_MODEL_NAME=
RULE_RETRIEVER_MAX_NEW_TOKENS=1400

# ---------- Schema-constrained extraction model ----------
EXTRACTION_MODE=local
EXTRACTION_API_KEY=
EXTRACTION_API_BASE=
EXTRACTION_MODEL_NAME=Qwen3-8B
EXTRACTION_MODEL_PATH=models/Qwen3-8B
EXTRACTION_TP=1
EXTRACTION_MAX_INPUT_TOKENS=20000
EXTRACTION_MAX_NEW_TOKENS=1400
EXTRACTION_GPU_MEMORY_UTILIZATION=0.90
EXTRACTION_USE_SFT=1
EXTRACTION_SFT_LORA_PATH=adapters/qwen3-8b-extraction
EXTRACTION_SFT_NAME=qwen3_8b_extraction_sft
EXTRACTION_SFT_ID=1

# ---------- Optional unit-normalization model ----------
NORMALIZATION_MODE=api
NORMALIZATION_API_KEY=
NORMALIZATION_API_BASE=
NORMALIZATION_MODEL_NAME=
NORMALIZATION_MODEL_PATH=
NORMALIZATION_TP=1
NORMALIZATION_MAX_INPUT_TOKENS=20000
NORMALIZATION_MAX_NEW_TOKENS=800
NORMALIZATION_GPU_MEMORY_UTILIZATION=0.90

# ---------- Optional web search ----------
BING_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
WEB_TIMEOUT_SEC=15
WEB_MAX_HITS=6

# ---------- Repository-relative paths ----------
DATASET_CSV=data/processed/test_data.csv
CASE_LIBRARY_JSON=data/processed/case_library_merged_v1_8.json
MEMORY_DIR=artifacts/memory
TOOL_PATH=artifacts/calculators/gpt_5_5
OUTPUT_DIR=output
RESULT_DIR=result
JUDGE_DIR=judge

# ---------- Submitted main-run behavior ----------
LOCAL_TOOLS_ONLY=1
DISABLE_CASE_RETRIEVER=0
DISABLE_UNIT_NORMALIZER=1
EXTRACTION_MEDBENCH_COMPAT=1
EXTRACTION_FORCE_SCHEMA_REQUIRED=1
MAX_REFLECT_ROUNDS=1
CASE_SEARCH_TOPK=3
TOOL_INPUT_POLICY=raw_only
JUDGE_EXTRACTION_SOURCE=raw
ENABLE_CENTRAL_FINAL_ANSWER=1
TRACE_FULL_LLM_IO=0
REQUIRE_CORE_LLMS_AVAILABLE=1

# Evaluation always uses the submitted answer adapter and scoring protocol.
# See results/KNOWN_ISSUES.md for its relationship to the upstream evaluator.

# Optional on-demand builder settings. The standalone toolmed-build-tools CLI
# instead uses --sample_per_calc/--max_rounds (including initial generation).
# Latest-manuscript / archived profile: 5 total rounds = initial + 4 repairs,
# using 8 training examples for validation. See generation_summary.json and
# docs/REPRODUCTION.md. These values do not change the released calculators.
TOOL_WRITER_MAX_ROUNDS=5
TOOL_WRITER_SAMPLE_PER_CALC=8
TOOL_EXEC_TIMEOUT_SEC=3
